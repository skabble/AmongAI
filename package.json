{
  "name": "amongai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @amongai/client",
    "start": "npm run start -w @amongai/server",
    "test": "node node_modules/vitest/vitest.mjs run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "bots": "npm run bots -w @amongai/server"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
